# Copy this file to .env for local development. Never commit real values.
GEMINI_API_KEY=
YOUTUBE_API_KEY=
X_BEARER_TOKEN=

# Runtime configuration
GEMINI_MODEL=gemini-2.5-flash
YAHOO_MAX_QUERIES=3
YAHOO_NEWS_ARTICLES_PER_QUERY=10
YAHOO_COMMENTS_PER_ARTICLE=500
YAHOO_COMMENT_MAX_PAGES=50
YAHOO_QUESTIONS_PER_QUERY=10
YAHOO_ANSWERS_PER_QUESTION=10
MINKARA_MAX_QUERIES=3
MINKARA_POSTS_PER_QUERY=10
MINKARA_COMMENTS_PER_POST=20
YOUTUBE_MAX_VIDEOS=20
YOUTUBE_COMMENTS_PER_VIDEO=50
YOUTUBE_MAX_SEARCH_WINDOWS=36
YOUTUBE_COMMENT_SAFETY_LIMIT=1000
YOUTUBE_COMMENT_MAX_PAGES=20
YOUTUBE_ANALYZER_COMMENT_LIMIT=100
YOUTUBE_ANALYZER_MAX_PAGES=100
X_MAX_POSTS=100
GEMINI_BATCH_SIZE=30
GEMINI_MAX_ATTEMPTS=2
GEMINI_RETRY_BASE_SECONDS=0.5
GEMINI_RETRY_MAX_SECONDS=4
DEFAULT_DATE_RANGE_DAYS=30
REQUEST_TIMEOUT_SECONDS=20
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_READ_TIMEOUT_SECONDS=15
HTTP_MAX_RETRIES=2
HTTP_BACKOFF_BASE_SECONDS=0.25
HTTP_BACKOFF_MAX_SECONDS=4
CACHE_TTL_SECONDS=3600
MAX_QUERY_VARIANTS_PER_SOURCE=5
JAPAN_MARKET_INCLUDE_THRESHOLD=0.75
JAPAN_MARKET_REVIEW_THRESHOLD=0.50
