# Copy only for local Streamlit testing as `.streamlit/secrets.toml`.
# Never commit the real file. For Community Cloud, paste these keys into
# App settings > Secrets instead.

GEMINI_API_KEY = "replace-with-your-gemini-key"
YOUTUBE_API_KEY = "replace-with-your-youtube-key"
GEMINI_MODEL = "gemini-2.5-flash"
